mqtt:
  host: localhost  # IP/host de tu broker Mosquitto; localhost si lo instalas en el mismo PC
  port: 1883
  topic_prefix: lab

instrumentos:
  "00000000": kiprim_dc605s   # sustituye por el número de serie real (sale en el log al arrancar el bridge)
  # "11111111": kiprim_dc310s

limites:
  kiprim_dc605s:
    voltage_max: 15.0
    current_max: 3.0
  kiprim_dc310s:
    voltage_max: 32.0
    current_max: 10.0

logging:
  dir: sesiones
  intervalo_s: 1.0
