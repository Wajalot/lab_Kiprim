[Unit]
Description=Bridge Kiprim/OWON - control de fuentes de laboratorio
After=network.target

[Service]
Type=simple
WorkingDirectory=/ruta/a/fuente-alimentacion
ExecStart=/ruta/a/fuente-alimentacion/.venv/bin/python -m bridge.service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
